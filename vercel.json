{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "functions": {
    "api/upload.js": { "maxDuration": 30 },
    "api/edge-upload.js": { "runtime": "edge" }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" }
  ]
}
